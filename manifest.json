{
  "manifest_version": 3,
  "name": "MoxgateEnhanced",
  "description": "Unhosted client: launch live Moxgate in a dedicated window and apply local-only themes.",
  "version": "0.1.1",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://moxgate.com/*",
    "https://www.moxgate.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://moxgate.com/*",
        "https://www.moxgate.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Open MoxgateEnhanced"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-192.png",
    "48": "icon-192.png",
    "128": "icon-192.png"
  }
}
