{
  "manifest_version": 3,
  "name": "MoxgateEnhanced",
  "description": "Local-first Moxgate homepage and menu themes. Opens settings directly in the toolbar; gameplay untouched.",
  "version": "0.3.1",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://moxgate.com/*",
    "https://www.moxgate.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://moxgate.com/*",
        "https://www.moxgate.com/*"
      ],
      "js": [
        "home-portal.js",
        "content.js"
      ],
      "run_at": "document_start",
      "css": [
        "content.css",
        "home-portal.css"
      ]
    }
  ],
  "action": {
    "default_title": "MoxgateEnhanced settings",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon-192.png",
    "48": "icon-192.png",
    "128": "icon-192.png"
  }
}
